{
  "name": "markspot",
  "version": "0.1.0",
  "description": "Marque un endroit d'une page web et laisse une note : Claude Code la lit, corrige le code et répond sur la page.",
  "license": "Apache-2.0",
  "type": "module",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/adryserage/Markspot.git"
  },
  "bin": {
    "markspot": "dist/cli.js"
  },
  "files": [
    "dist/",
    "extension/manifest.json",
    "extension/_locales/",
    "extension/dist/",
    "skill/"
  ],
  "engines": {
    "node": ">=22.18"
  },
  "scripts": {
    "build": "node build.mjs",
    "typecheck": "tsc --noEmit",
    "test": "node --test tests/unit/",
    "smoke": "node tests/smoke-mcp.ts && node tests/smoke-listen.ts",
    "e2e:real": "npm run build && node tests/e2e/real-session.e2e.ts",
    "e2e": "node tests/e2e/annotate.e2e.ts && node tests/e2e/edit-delete.e2e.ts"
  },
  "devDependencies": {
    "@fontsource/atkinson-hyperlegible": "5.3.0",
    "@modelcontextprotocol/client": "2.4.0",
    "@modelcontextprotocol/server": "2.4.0",
    "@types/chrome": "0.3.7",
    "@types/node": "26.6.6",
    "esbuild": "0.28.2",
    "playwright-core": "1.65.0",
    "typescript": "7.0.2",
    "ulid": "3.0.2",
    "zod": "4.6.7"
  }
}
