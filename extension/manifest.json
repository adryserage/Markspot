{
  "manifest_version": 3,
  "name": "Markspot",
  "version": "0.4.0",
  "version_name": "0.4.0-beta.0",
  "description": "__MSG_extDescription__",
  "default_locale": "en",
  "key": "",
  "minimum_chrome_version": "130",
  "icons": {
    "16": "icons/icon-16.png",
    "32": "icons/icon-32.png",
    "48": "icons/icon-48.png",
    "128": "icons/icon-128.png"
  },
  "permissions": [
    "activeTab",
    "scripting",
    "storage",
    "unlimitedStorage",
    "contextMenus",
    "nativeMessaging"
  ],
  "background": {
    "service_worker": "dist/background.js",
    "type": "module"
  },
  "action": {
    "default_title": "__MSG_actionTitle__",
    "default_icon": {
      "16": "icons/icon-16.png",
      "32": "icons/icon-32.png"
    }
  },
  "commands": {
    "toggle-annotate": {
      "suggested_key": {
        "default": "Alt+C"
      },
      "description": "__MSG_commandToggle__"
    }
  },
  "web_accessible_resources": [
    {
      "resources": [
        "dist/fonts/*"
      ],
      "matches": [
        "<all_urls>"
      ]
    }
  ]
}
