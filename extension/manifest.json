{
  "manifest_version": 3,
  "name": "Markspot",
  "version": "0.1.0",
  "description": "Marque un endroit d’une page et laisse une note pour Claude Code.",
  "key": "",
  "minimum_chrome_version": "130",
  "permissions": [
    "activeTab",
    "scripting",
    "storage",
    "unlimitedStorage",
    "contextMenus",
    "nativeMessaging"
  ],
  "background": {
    "service_worker": "dist/background.js",
    "type": "module"
  },
  "action": {
    "default_title": "Markspot : annoter cette page (Alt+C)"
  },
  "commands": {
    "toggle-annotate": {
      "suggested_key": {
        "default": "Alt+C"
      },
      "description": "Activer ou couper le mode annotation"
    }
  },
  "web_accessible_resources": [
    {
      "resources": [
        "dist/fonts/*"
      ],
      "matches": [
        "<all_urls>"
      ]
    }
  ]
}
